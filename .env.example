# Fail2ban configuration
# Comma-separated list of fail2ban jails to unban IPs from
ALLOWED_JAILS=sshd,nginx-http-auth,postfix

# Timezone
TZ=UTC

# Socket watchdog: restarts the container when the fail2ban socket is missing,
# unusable (e.g. permissions reset by a fail2ban restart) or not answering ping
WATCHDOG_ENABLED=true
# Seconds between probes
WATCHDOG_INTERVAL=30
# Consecutive failed probes before the container is stopped (restart: always brings it back)
WATCHDOG_FAILURES=3
